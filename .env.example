# Upstash Redis. Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN,
# which the app also accepts. Set one pair or the other.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# The shared login PIN. Exactly 6 digits.
FAMILY_PIN=

# Secret used to sign the login cookie. At least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
